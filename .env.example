# Server
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173

# Database
SQL_CONNECTION_STRING=Server=localhost;Database=[APP_NAME]-dev;User Id=sa;Password=yourpassword;Encrypt=false;

# Session
SESSION_SECRET=vervang-met-64-willekeurige-tekens
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=[app-naam].sid

# Encryptie (TOTP secrets)
ENCRYPTION_KEY=64-hex-tekens-hier-invullen

# Azure Communication Services
ACS_CONNECTION_STRING=endpoint=https://your-acs.communication.azure.com/;accesskey=...
ACS_FROM_EMAIL=noreply@vanbommel.nl

# Bootstrap admin (eerste keer inloggen)
# Het admin-account wordt aangemaakt via migratie 002_seed_admin.sql.
# Vul hier je eigen tijdelijke wachtwoord in; nooit een wachtwoord in code committen.
BOOTSTRAP_ADMIN_EMAIL=reyniervanbommel@vanbommel.nl
BOOTSTRAP_ADMIN_PASSWORD=zet-hier-een-sterk-tijdelijk-wachtwoord

# App URL (voor resetlinks in e-mails)
APP_BASE_URL=http://localhost:5173
