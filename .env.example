# Server
NODE_ENV=development
APP_ENV=dev
PORT=3008
ALLOWED_ORIGINS=http://localhost:5178

# Database
SQL_CONNECTION_STRING=Server=localhost;Database=[APP_NAME]-dev;User Id=sa;Password=yourpassword;Encrypt=false;

# Session
SESSION_SECRET=vervang-met-64-willekeurige-tekens
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=[app-naam].sid

# Encryptie (TOTP secrets)
ENCRYPTION_KEY=64-hex-tekens-hier-invullen

# Azure Communication Services
ACS_CONNECTION_STRING=endpoint=https://your-acs.communication.azure.com/;accesskey=...
ACS_FROM_EMAIL=noreply@vanbommel.nl

# D365 OData (Supplier Portal read)
D365_ODATA_BASE_URL=https://your-d365-instance.operations.dynamics.com
D365_ODATA_PURCHASE_ORDERS_PATH=/data/PurchaseOrderHeadersV2
D365_ODATA_COMPANY=usmf

# D365 OAuth2 client-credentials (vervangt het handmatige bearer token)
# Scope = <D365_ODATA_BASE_URL>/.default ; secret hoort in Key Vault, niet in git.
D365_ODATA_TENANT_ID=
D365_ODATA_CLIENT_ID=
D365_ODATA_CLIENT_SECRET=

# Legacy fallback: handmatig delegated token (verloopt ~1u). Leeg laten bij client-credentials.
D365_ODATA_BEARER_TOKEN=

# Bootstrap admin (eerste keer inloggen)
# Migratie 002_seed_admin.sql gebruikt deze vars om het admin-account aan te maken.
# Vul een sterk tijdelijk wachtwoord in; nooit een wachtwoord in code committen.
BOOTSTRAP_ADMIN_EMAIL=admin@jouwdomein.nl
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin
BOOTSTRAP_ADMIN_PASSWORD=zet-hier-een-sterk-tijdelijk-wachtwoord

# App URL (voor resetlinks in e-mails)
APP_BASE_URL=http://localhost:5178

# Azure DevOps MCP (Cursor — niet voor Express backend)
# Cloud agents: zet ADO_MCP_AUTH_TOKEN in Cursor Dashboard → Cloud Agents → Secrets
# Lokaal: .\refresh-ado-mcp-token.ps1 -PersistToUserEnv
# ADO_MCP_AUTH_TOKEN=
