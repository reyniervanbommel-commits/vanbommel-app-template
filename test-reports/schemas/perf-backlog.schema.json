{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "perf-backlog",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scrollMeasuredAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "profiles": { "type": "array", "items": { "enum": ["S", "M", "L"] } }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/backlogItem" }
    }
  },
  "definitions": {
    "journey": {
      "enum": ["J1", "J2", "J3", "J4", "J5", "J6", "J7", "J8"],
      "description": "J1–J3 load, J4 scroll, J5–J6 board, J7 filter, J8 text style"
    },
    "backlogItem": {
      "type": "object",
      "required": ["id", "journey", "action", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^BL-[0-9]{3}$" },
        "journey": { "$ref": "#/definitions/journey" },
        "action": { "type": "string" },
        "profile": { "enum": ["S", "M", "L"] },
        "status": { "enum": ["open", "in-progress", "verifying", "done", "skipped", "blocked"] },
        "elapsedWall": { "type": ["number", "null"] },
        "maxLongFrameMs": { "type": ["number", "null"] },
        "scrollJankMs": { "type": ["number", "null"] },
        "scrollStableMs": { "type": ["number", "null"] },
        "filterApplyMs": { "type": ["number", "null"] },
        "textStyleApplyMs": { "type": ["number", "null"] },
        "targetFilterMs": { "type": ["number", "null"] },
        "targetStyleMs": { "type": ["number", "null"] },
        "expandStableMs": { "type": ["number", "null"] },
        "app": { "type": ["number", "null"] },
        "apiSum": { "type": ["number", "null"] },
        "duplicatePoFetchCount": { "type": ["number", "null"] },
        "dominantPost": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "targetWallMs": { "type": ["number", "null"] },
        "targetLongFrameMs": { "type": ["number", "null"] },
        "routeFrequencyWeight": { "type": "number" },
        "priorityScore": { "type": "number" },
        "attemptedTiers": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
