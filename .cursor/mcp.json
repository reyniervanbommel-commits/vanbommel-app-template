{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--output-dir=playwright/mcp",
        "--output-mode=file"
      ]
    },
    "d365-fo-mcp": {
      "url": "https://vanbommel-acc.sandbox.operations.dynamics.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:D365_MCP_TOKEN}"
      }
    },
    "Devops": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "ReyniervanBommel0745",
        "--authentication",
        "envvar",
        "-d",
        "core",
        "work",
        "work-items"
      ],
      "env": {
        "ADO_MCP_AUTH_TOKEN": "${env:ADO_MCP_AUTH_TOKEN}",
        "ado_mcp_project": "d7db55dd-a46b-4c68-a6a1-b6cbc1ef23c7"
      }
    }
  }
}
