{
  "name": "vendorportal",
  "version": "1.0.7",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node --watch server/server.js",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "vite build",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "start": "node server/server.js",
    "migrate:db": "node scripts/db/run-migrations.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/communication-email": "^1.0.0",
    "@fluentui/react-components": "^9.54.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "mssql": "^10.0.4",
    "multer": "^1.4.5-lts.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.7",
    "react-router-dom": "^6.26.0",
    "recharts": "^3.9.0",
    "winston": "^3.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.2",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
